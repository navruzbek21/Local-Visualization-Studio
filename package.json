{
  "name": "local-visualization-studio",
  "version": "1.2.0",
  "description": "Локальная студия визуализации данных (аналог Flourish) на Apache ECharts — работает без интернета",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "vendor": "node scripts/vendor.mjs",
    "build:maps": "node scripts/build-maps.mjs",
    "prepare-offline": "npm run vendor && npm run build:maps",
    "test": "node --test tests/",
    "build:examples": "node scripts/build-examples.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "devDependencies": {
    "echarts": "^6.1.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "optionalDependencies": {
    "mssql": "^12.7.6",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  }
}
